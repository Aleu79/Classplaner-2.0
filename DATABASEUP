CREATE TABLE "user" (
 "id"         INT8 NOT NULL,
 "username"   VARCHAR(100),
 "role_id"    INT8,
 "first_name" VARCHAR(100),
 "last_name"  VARCHAR(100),
 "email"      VARCHAR(250),
 "password"   VARCHAR(500),
 "created_at" TIMESTAMP,
 "updated_at" TIMESTAMP,
 "deleted_at" TIMESTAMP
);
ALTER TABLE "user"
ALTER COLUMN "id" 
ADD GENERATED BY DEFAULT AS IDENTITY (MINVALUE 1 START WITH 1 INCREMENT BY 1);

CREATE TABLE "role" (
 "id"          INT8,
 "name"        VARCHAR(250),
 "description" VARCHAR(250),
 "created_at"  TIMESTAMP,
 "updated_at"  TIMESTAMP,
 "deleted_at"  TIMESTAMP
);
ALTER TABLE "role" ADD PRIMARY KEY("id");

CREATE TABLE "calendar" (
 "id"         INT8,
 "title"      VARCHAR(100),
 "desc"     VARCHAR(400),
 "id_task"    VARCHAR(100),
 "created"    TIMESTAMP,
 "deliver"    TIMESTAMP,
 "class_name" VARCHAR(100),
 "curso"      VARCHAR(10)
);
ALTER TABLE "calendar" ADD PRIMARY KEY("id");

CREATE TABLE "classes" (
 "id"       INT8,
 "name"     VARCHAR(100),
 "profesor" VARCHAR(100),
 "curso"    VARCHAR(100),
 "color"    VARCHAR(100),
 "token"    VARCHAR(100)
);
ALTER TABLE "classes" ADD PRIMARY KEY("id");

CREATE TABLE "comment" (
 "id"         INT8,
 "task"       VARCHAR(100),
 "text"       VARCHAR(500),
 "user_name"  VARCHAR(100),
 "time"     TIMESTAMP,
 "user_photo" VARCHAR(300)
);
ALTER TABLE "comment" ADD PRIMARY KEY("id");

CREATE TABLE "submission" (
 "id"           INT8,
 "id_user"      INT8,
 "id_task"      INT8,
 "file"         VARCHAR(500),
 "comment"      VARCHAR(500),
 "date"         TIMESTAMP,
 "calification" FLOAT8,
 "feedback"     VARCHAR(500),
 "username"     VARCHAR(100),
 "lastname"     VARCHAR(100),
 "alias"        VARCHAR(100),
 "photo"        VARCHAR(500)
);

CREATE TABLE "tasks" (
 "id"          INT8,
 "titulo"      VARCHAR(200),
 "description" VARCHAR(1000),
 "creado"      TIMESTAMP,
 "limite"      TIMESTAMP
);
ALTER TABLE "tasks" ADD PRIMARY KEY("id");
ALTER TABLE "tasks" ADD CONSTRAINT "fk_classes_tasks" FOREIGN KEY ("id") REFERENCES "classes"("id");

CREATE TABLE "user_class" (
 "name"      VARCHAR(100),
 "last_name" VARCHAR(100),
 "photo"     VARCHAR(300),
 "type"      VARCHAR(100)
);

CREATE TABLE "address" (
 "id"          INT8,
 "user_id"     INT8,
 "name"        VARCHAR(250),
 "is_primary"  BOOL,
 "city_id"     INT8,
 "province_id" INT8,
 "address1"    VARCHAR(250),
 "address2"    VARCHAR(250),
 "phone"       VARCHAR(250),
 "email"       VARCHAR(250),
 "post_code"   VARCHAR(250),
 "created_at"  TIMESTAMP,
 "updated_at"  TIMESTAMP,
 "deleted_at"  TIMESTAMP
);
ALTER TABLE "address" ADD PRIMARY KEY("id");